# Copia el contenido de wiki/site/ a /var/www/mesifly-wiki/ (index.html en esa carpeta).
server {
    server_name wiki.mesifly.com;
    root /var/www/mesifly-wiki;

    location / {
        try_files $uri $uri/ =404;
        error_page 404 /404.html;
        gzip on; gzip_types text/css application/javascript application/json text/plain application/xml;
    }
    location /assets/ { expires 30d; add_header Cache-Control "public"; }
}
